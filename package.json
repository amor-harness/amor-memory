{
  "name": "@amor-harness/memory",
  "version": "0.1.0",
  "description": "Amor 记忆系统插件：记忆库、领域、抽取、召回、注入、VFS 与图片记忆。",
  "license": "MIT",
  "keywords": [
    "amor",
    "memory",
    "agent",
    "rag",
    "cordis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amor-harness/amor-memory.git"
  },
  "homepage": "https://github.com/amor-harness/amor-memory#readme",
  "bugs": {
    "url": "https://github.com/amor-harness/amor-memory/issues"
  },
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "LICENSE",
    "plugin.json",
    "config.example.json",
    "README.md",
    "README.en.md",
    "docs/",
    "runtime/dist/",
    "client/dist/index.mjs"
  ],
  "scripts": {
    "build": "npm run build:runtime && npm run build:client",
    "watch": "npm run build -- --watch",
    "build:test": "esbuild client/test/entry.ts --bundle --format=esm --outfile=client/.test/bundle.mjs --jsx-factory=h --jsx-fragment=Fragment --target=es2020 --log-level=warning",
    "pretest": "npm run build && npm run build:test",
    "test": "node client/test/render.mjs && node client/test/interaction.mjs && node client/test/scope.mjs && npm run test:runtime",
    "test:runtime": "node --test runtime/test/*.test.mjs",
    "build:runtime": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:client": "tsc -p tsconfig.client.json",
    "build:client": "esbuild client/src/index.ts --bundle --format=esm --outfile=client/dist/index.mjs --jsx-factory=h --jsx-fragment=Fragment --target=es2020 --log-level=warning"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  },
  "author": {
    "name": "Amor",
    "email": "amor@gilatod.art",
    "url": "https://github.com/amor-harness"
  },
  "peerDependencies": {
    "@amor-harness/agent-runtime": "^0.1.0",
    "@amor-harness/database": "^0.1.0",
    "@amor-harness/i18n": "^0.1.0",
    "@amor-harness/permissions": "^0.1.0"
  }
}
